# Amol Novin (Sage) — keep source / config files private (Sage deployment guide).
# Nginx equivalent:  location ~* \.(blade\.php)$ { deny all; }   location ~* /(composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js)$ { deny all; }
<FilesMatch "(\.blade\.php|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|phpcs\.xml\.dist|\.editorconfig|\.gitignore|README\.md|LICENSE\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
