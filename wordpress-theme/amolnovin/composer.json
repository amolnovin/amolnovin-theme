{
  "name": "amolnovin/amolnovin-sage",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "قالب وردپرس «فناوری اطلاعات آمل نوین» — ساخته‌شده با Sage 11 (Acorn + Blade + Vite)؛ تبدیل کامل قالب HTML به وردپرس",
  "homepage": "https://amolnovin.ir",
  "authors": [
    {
      "name": "Amol Novin IT",
      "homepage": "https://amolnovin.ir"
    }
  ],
  "keywords": [
    "wordpress",
    "sage",
    "acorn",
    "blade",
    "rtl",
    "persian"
  ],
  "support": {
    "issues": "https://amolnovin.ir/contact-us/"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "suggest": {
    "log1x/sage-directives": "A collection of useful Blade directives for WordPress and Sage (^1.0)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ],
    "lint": "phpcs --standard=phpcs.xml.dist",
    "fix": "phpcbf --standard=phpcs.xml.dist"
  }
}
